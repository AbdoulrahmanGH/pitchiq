SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# Only used by app/data/seed_demo_users.py, for Supabase Auth Admin API
# calls (creating demo users directly, bypassing email confirmation). The
# legacy service_role JWT (Project Settings -> API -> Legacy API Keys), not
# the new secret key above -- see that file's docstring for why. Nothing
# else in the app reads this variable.
SUPABASE_SERVICE_ROLE_JWT=your-legacy-service-role-jwt
